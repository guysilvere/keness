{
  "name": "keness",
  "version": "0.1.0",
  "description": "Create your skills, agents, rules and MCP configs once — sync them everywhere.",
  "type": "module",
  "bin": {
    "keness": "./bin/keness.js"
  },
  "files": ["bin", "dist"],
  "keywords": [
    "ai",
    "claude",
    "cursor",
    "codex",
    "gemini",
    "opencode",
    "skills",
    "agents",
    "rules",
    "mcp",
    "sync",
    "local-first",
    "cli"
  ],
  "homepage": "https://keness.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/guysilvere/keness.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/guysilvere/keness/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@keness/core": "workspace:*",
    "@keness/web": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
